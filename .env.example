# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Zerodha Kite Connect ----
# Get API key/secret from https://developers.kite.trade/
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
# Access token expires daily; regenerate by logging in via the Kite login URL
# and exchanging the request_token. See README in main.py docstring.
KITE_ACCESS_TOKEN=your_daily_access_token_here

# ---- Telegram alerts ----
# Create a bot via @BotFather; get chat_id by messaging the bot then visiting
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
